{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(uv run:*)",
      "Bash(npm run build:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "context": {
    "readFiles": [
      "AGENTS.md",
      "README.md",
      "project_context.md"
    ],
    "memoryPatterns": [
      ".agents/**",
      "harness/**/memory*.md",
      "harness/**/status*.md"
    ]
  }
}
